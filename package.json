{
  "name": "moura",
  "version": "0.1.0",
  "description": "Git-native traceability and verification coverage CLI",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "bin": {
    "moura": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
